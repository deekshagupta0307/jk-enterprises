# ==============================================================================
# JK Enterprises — Environment Configuration & Production Readiness
# ==============================================================================
# IMPORTANT:
# - Do NOT commit real secrets or production credentials to source control.
# - On Vercel, configure these variables under: Project Settings > Environment Variables.
# - For local development, copy this file to `.env.local` and provide your local credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Connection (Prisma 7 + @prisma/adapter-pg)
# ------------------------------------------------------------------------------
# REQUIRED for durable order storage, authentication, and live catalogue persistence.
# Build time: NEXT_PHASE builds succeed without DB (uses static/demo data).
# Production runtime: MANDATORY. Order creation will strictly fail if unconfigured.
#
# Supported providers: Neon, Supabase, Vercel Postgres, AWS RDS, or local Docker.
# Example format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public&sslmode=require
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/jk_enterprises?schema=public"

# ------------------------------------------------------------------------------
# 2. Database Migration & Provisioning Guide
# ------------------------------------------------------------------------------
# How to apply migrations locally or to a remote PostgreSQL database:
#   1. Set DATABASE_URL in your terminal or .env.local
#   2. Apply official migrations:
#        npx prisma migrate deploy
#   3. Seed the catalogue with initial categories, brands, and products:
#        npm run db:seed
#   4. Check migration status:
#        npx prisma migrate status
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 3. Application Environment
# ------------------------------------------------------------------------------
# Set to "production" in production environments (automatically set by Vercel).
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 4. Better Auth Secret & Session Security
# ------------------------------------------------------------------------------
# REQUIRED in production runtime. Must be a cryptographically secure random string
# with a minimum length of 32 characters.
# Generate via: openssl rand -base64 32
# Insecure, short, or placeholder values are strictly rejected by the production gate.
BETTER_AUTH_SECRET="replace-with-at-least-32-character-cryptographic-random-secret"

# ------------------------------------------------------------------------------
# 5. Base URL & Trusted Origins
# ------------------------------------------------------------------------------
# Recommended for custom domain deployments.
# On Vercel, automatically falls back to VERCEL_PROJECT_PRODUCTION_URL or VERCEL_URL.
BETTER_AUTH_URL="http://localhost:3000"

# Optional: Comma-separated list of additional trusted origins for CORS & CSRF
# AUTH_TRUSTED_ORIGINS="https://jkenterprises.rajasthan.in,https://trade.jkenterprises.rajasthan.in"

# ------------------------------------------------------------------------------
# 6. Commercial Business Information (Overrides placeholders in businessConfig.ts)
# ------------------------------------------------------------------------------
# Replace with the official registered enterprise credentials prior to public launch.
BUSINESS_PHONE="9928769266"
BUSINESS_EMAIL="akguptabkn@gmail.com"
BUSINESS_WHATSAPP_NUMBER="9928769266"
BUSINESS_ADDRESS="Bikaner, Rajasthan, India"
# BUSINESS_GSTIN="08AAAAA0000A1Z5"
# BUSINESS_PAN="AAAAA0000A"

# ------------------------------------------------------------------------------
# 7. Manual UPI QR & Bank Transfer Payment Endpoints
# ------------------------------------------------------------------------------
# NOTE: Live payment processing is intentionally disabled until real business banking
# details are configured by the business owner.
#
# UPI Endpoint:
# PAYMENT_UPI_ID="jkenterprises@upi"
# PAYMENT_PAYEE_NAME="JK Enterprises"
# PAYMENT_UPI_QR_URL="/images/payment/upi-qr-code.png"
#
# Bank Account (NEFT / RTGS / IMPS):
# PAYMENT_BANK_ACCOUNT_NAME="JK Enterprises"
# PAYMENT_BANK_ACCOUNT_NUMBER="XXXXXXXXXXXX1234"
# PAYMENT_BANK_IFSC="SBIN000XXXX"
# PAYMENT_BANK_NAME="State Bank of India (SBI)"
# PAYMENT_BANK_BRANCH="Bikaner Main Branch, Rajasthan"
