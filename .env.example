# ==============================================================================
# JK Enterprises — Environment Configuration Template
# ==============================================================================

# 1. PostgreSQL Database Connection URL (Prisma 7 + pg adapter)
# - Build Time: NOT REQUIRED (Build succeeds without database; uses verified demo data)
# - Runtime: REQUIRED for live accounts, auth sessions, and database persistence
# - Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/jk_enterprises?schema=public"

# 2. Application Environment
# - Automatically set to "production" by Vercel deployments
NODE_ENV="development"

# 3. Better Auth Secret
# - Build Time: NOT REQUIRED (Uses build-time static evaluation key)
# - Runtime: STRICTLY REQUIRED in production. Must be a cryptographically random
#   string of at least 32 characters (e.g. generated via `openssl rand -base64 32`).
#   Insecure, short (<32 chars), or development placeholder strings are rejected.
BETTER_AUTH_SECRET="your-secure-random-secret-at-least-32-chars-long"

# 4. Better Auth Base URL & Trusted Origins
# - Build Time: NOT REQUIRED
# - Runtime: Recommended for custom domains. On Vercel, automatically falls back to
#   https://${VERCEL_PROJECT_PRODUCTION_URL} or https://${VERCEL_URL} if omitted.
BETTER_AUTH_URL="http://localhost:3000"

# Optional: Additional comma-separated trusted origins for CORS / CSRF
# AUTH_TRUSTED_ORIGINS="https://jkenterprises.rajasthan.in,https://trade.jkenterprises.rajasthan.in"
